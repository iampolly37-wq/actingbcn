---
import type { CollectionEntry } from "astro:content";

type Facts = CollectionEntry<"courses">["data"]["facts"];

interface Props {
  facts: Facts;
  offer?: string;
  spotsLeft?: number;
}

const { facts, offer, spotsLeft } = Astro.props;
const spotsWord = spotsLeft
  ? spotsLeft % 10 === 1 && spotsLeft % 100 !== 11
    ? "место"
    : [2, 3, 4].includes(spotsLeft % 10) &&
        ![12, 13, 14].includes(spotsLeft % 100)
      ? "места"
      : "мест"
  : "";
---

<aside class="course-facts" aria-label="Условия">
  <dl class="course-facts__list">
    {
      facts.map((fact) => (
        <>
          <dt>{fact.label}</dt>
          <dd>
            {fact.lines.map((line, index) => (
              <>
                {fact.datetime && index === 0 ? (
                  <time datetime={fact.datetime}>{line}</time>
                ) : (
                  line
                )}
                {index < fact.lines.length - 1 && <br />}
              </>
            ))}
          </dd>
        </>
      ))
    }
  </dl>
  {offer && <p class="course-offer">{offer}</p>}
  <div class="course-facts__actions">
    {
      spotsLeft && (
        <p class="button course-availability">
          Осталось {spotsLeft} {spotsWord}
        </p>
      )
    }
    <a class="button button-dark" href="/apply/"> Выбрать этот курс </a>
  </div>
</aside>
