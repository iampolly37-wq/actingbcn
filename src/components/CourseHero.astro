---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  course: CollectionEntry<"courses">;
}

const { course } = Astro.props;
const spotsLeft = course.data.spotsLeft;
const spotsWord = spotsLeft
  ? spotsLeft % 10 === 1 && spotsLeft % 100 !== 11
    ? "место"
    : [2, 3, 4].includes(spotsLeft % 10) &&
        ![12, 13, 14].includes(spotsLeft % 100)
      ? "места"
      : "мест"
  : "";
---

<header class="detail-hero">
  <div class="detail-image-wrap">
    <Image
      src={course.data.heroImage}
      alt={course.data.heroAlt}
      class="detail-image"
      widths={[720, 1080, 1440]}
      sizes="(max-width: 900px) 100vw, 45vw"
      format="webp"
      quality={82}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="detail-title">
    <div class="detail-meta">
      <p class="course-type">{course.data.type}</p>
      {
        spotsLeft && (
          <p class="course-availability">
            <span aria-hidden="true" />
            Осталось {spotsLeft} {spotsWord}
          </p>
        )
      }
    </div>
    <h1>{course.data.title}</h1>
    <p class="detail-intro">{course.data.intro}</p>
  </div>
</header>
